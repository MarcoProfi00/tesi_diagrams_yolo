{
  "title": "Test startup con condizioni iniziali asimmetriche su rete RC/base",
  "hypothesis": "L'oscillatore resta quasi bloccato per simmetria all'avvio; rompendo la simmetria iniziale tra il nodo del condensatore e la base del transistor dovrebbe comparire un lampeggio piu regolare o almeno un duty cycle sensibilmente maggiore.",
  "intent": "diagnostic",
  "analysis": "tran",
  "actions": [
    {
      "type": "set_initial_node_voltage",
      "target": "N001",
      "value": "5V",
      "skip_operating_point": true
    },
    {
      "type": "set_initial_node_voltage",
      "target": "N004",
      "value": "0V",
      "skip_operating_point": true
    }
  ],
  "compare": [
    "@dled12_1[id]",
    "v(N001)",
    "v(N004)",
    "v(N003)"
  ],
  "measure": {
    "@dled12_1[id]": "tran_abs_peak"
  },
  "expect": {
    "@dled12_1[id]": "magnitude_increased",
    "v(N001)": "changed",
    "v(N004)": "changed",
    "v(N003)": "changed"
  },
  "temporal_expect": {
    "target": "Dled12_1",
    "required_state": "blinking",
    "require_regular_period": true,
    "min_relative_duty_increase": 0.5
  },
  "scenario_id": "agent_scenario_1"
}
