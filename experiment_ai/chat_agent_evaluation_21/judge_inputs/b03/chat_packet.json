  "reference": {
    "schema_version": 1,
    "circuit_id": "b03",
    "circuit_description": "Monitor di tensione per batteria a tre LED: rosso D1, giallo D2 e verde D7.\nDue transistor BC547 NPN e un BC557 PNP, insieme alle reti di diodi 1N4148\ne agli zener da 10 V e 12 V, creano finestre di indicazione dipendenti dalla\ntensione. Il Graph JSON coincide con l'immagine. Q3 conserva un ID storico\ndi classe NPN, ma è correttamente modellato in SPICE come BC557 PNP.\n",
    "task_type": "caratterizzazione statica e dinamica di un indicatore a soglie",
    "user_symptom": "Voglio verificare tutti e tre i LED: prova batteria scarica, normale e carica, poi fai una rampa di tensione per vedere come si accendono e spengono nel tempo.\n",
    "circuit_inventory": {
      "component_count": 22,
      "node_count": 17,
      "component_types": [
        "Battery",
        "Diode",
        "LED",
        "NPN_Transistor",
        "Resistor"
      ],
      "analysis_types": [
        "op",
        "tran"
      ]
    },
    "required_evidence": [
      {
        "id": "model_assumptions",
        "description": "L'immagine non riporta il valore della batteria e non contiene un\nsimbolo di massa. Il values.yaml assume una batteria automobilistica\nnominale da 12 V e aggiunge una sorgente ideale da 0 V sul terminale B\ncome riferimento SPICE. Queste scelte devono restare esplicite.\n"
      },
      {
        "id": "base_12v_state",
        "description": "A 12 V il LED rosso conduce circa 2.29e-11 A, il giallo circa 9.942 mA\ne il verde circa 6.02e-9 A: soltanto il giallo è operativamente acceso.\n"
      },
      {
        "id": "static_low_high_states",
        "description": "A 10 V il rosso conduce circa 8.238 mA e gli altri sono spenti secondo\nla soglia di 0.1 mA. A 14 V il giallo conduce circa 9.48 mA e il verde\ncirca 10.743 mA, mentre il rosso è spento. A 16 V resta acceso soltanto\nil verde, con circa 13.823 mA.\n"
      },
      {
        "id": "monotonic_ramp",
        "description": "Una rampa crescente della batteria deve verificare le correnti di tutti\ne tre i LED nel tempo. I profili transient_pulse rappresentano finestre\ndi conduzione attraversate una sola volta, non un lampeggio periodico.\n"
      },
      {
        "id": "threshold_windows",
        "description": "Analizzando direttamente i CSV con soglia LED di 0.1 mA, la rampa mostra:\nrosso solo fino a circa 11.53 V; rosso+giallo da circa 11.53 a 11.92 V;\ngiallo solo da circa 11.92 a 13.59 V; giallo+verde da circa 13.59 a\n14 V. Una prova statica a 16 V mostra poi il verde da solo.\n"
      }
    ],
    "success_conditions": [
      {
        "id": "all_three_leds_checked",
        "description": "La valutazione usa direttamente le correnti SPICE di rosso, giallo e\nverde e dimostra che ciascuno diventa attivo in una parte dell'intervallo.\n"
      },
      {
        "id": "low_normal_high_explained",
        "description": "La conclusione descrive correttamente almeno gli stati a 10 V, 12 V e\n14 V: rosso; giallo; giallo+verde.\n"
      },
      {
        "id": "ramp_sequence_explained",
        "description": "La rampa viene interpretata come sequenza di finestre di indicazione\nrosso, transizione rosso-giallo, giallo, transizione giallo-verde.\n"
      },
      {
        "id": "overlap_acknowledged",
        "description": "La conclusione non presenta il monitor come comparatore perfettamente\nesclusivo: sono presenti intervalli nei quali conducono due LED.\n"
      },
      {
        "id": "conclusion_calibrated",
        "description": "Soglie e correnti sono riferite ai modelli SPICE e alla soglia operativa\nscelta; non vengono presentate come misure garantite sull'hardware reale.\n"
      }
    ],
    "acceptable_solutions": [
      {
        "id": "static_points_plus_ramp",
        "description": "Eseguire prove statiche a 10 V, 12 V e 14 V e una rampa 10-14 V,\nconfrontando le tre correnti LED. La prova a 16 V è un'estensione utile\nper dimostrare lo stato verde-only.\n",
        "verified_reference_values": "10 V: rosso 8.238 mA, giallo 0.0756 mA, verde trascurabile. 12 V:\ngiallo 9.942 mA, rosso e verde trascurabili. 14 V: giallo circa\n9.48 mA e verde 10.743 mA. 16 V: verde 13.823 mA, altri trascurabili.\n"
      },
      {
        "id": "single_ramp_with_base",
        "description": "Usare il caso base a 12 V insieme a una sola rampa monotona 9-14 V è\nsufficiente per verificare che tutti e tre i LED si attivino e per\nricostruire la sequenza, purché siano esaminate le tre correnti e non\nsoltanto le etichette automatiche.\n",
        "verified_reference_values": "Nella rampa RUN 9-14 V i massimi sono circa 9.948 mA per il rosso,\n11.926 mA per il giallo e 10.743 mA per il verde. Con soglia 0.1 mA le\nfinestre risultano coerenti con la rampa RUN 10-14 V.\n"
      },
      {
        "id": "static_tests_without_ramp",
        "acceptance": "partial_only",
        "description": "I soli punti statici verificano alcuni stati, ma non mostrano l'ordine\ntemporale delle transizioni richiesto dall'utente.\n"
      },
      {
        "id": "ramp_without_individual_currents",
        "acceptance": "partial_only",
        "description": "Osservare soltanto la tensione della batteria o un unico LED non basta\nper dichiarare verificato il monitor a tre indicazioni.\n"
      }
    ],
    "unsupported_conclusions": [
      "Trattare Q3 come NPN a causa dell'ID del componente: l'immagine indica\nBC557 e la netlist usa correttamente un modello PNP.\n",
      "Presentare i 12 V come valore letto nell'immagine: è un'assunzione basata\nsul contesto automobilistico del circuito originale.\n",
      "Interpretare transient_pulse durante una rampa monotona come lampeggio o\ninstabilità: ogni soglia viene attraversata una sola volta.\n",
      "Affermare che a 14 V sia acceso soltanto il verde: SPICE mostra giallo e\nverde contemporaneamente; il verde-only è verificato a 16 V.\n",
      "Dichiarare perfettamente esclusive le indicazioni: i CSV mostrano sia una\nfascia rosso+giallo sia una fascia giallo+verde.\n",
      "Considerare fallita la rampa RUN perché D2 non soddisfa required_state=on:\nil criterio è inadatto a una finestra transitoria, mentre le correnti\ndimostrano correttamente il passaggio di tutti e tre i LED.\n",
      "Usare tran_vpp per confrontare due tensioni DC costanti: 10, 12, 14 e\n16 V hanno tutti Vpp nullo; occorrono valore medio, finale, minimo o massimo.\n"
    ]
  },
