{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatAgentEvaluation21JudgeResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "outcome",
    "outcome_reason",
    "criteria",
    "critical_errors",
    "decisive_evidence",
    "confidence"
  ],
  "properties": {
    "packet_id": {"type": "string", "minLength": 1},
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "partial_success",
        "failure",
        "inconclusive",
        "technical_failure"
      ]
    },
    "outcome_reason": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_correctness",
        "test_quality",
        "evidence_interpretation",
        "goal_achievement",
        "conclusion_quality"
      ],
      "properties": {
        "diagnostic_correctness": {"$ref": "#/$defs/criterion"},
        "test_quality": {"$ref": "#/$defs/criterion"},
        "evidence_interpretation": {"$ref": "#/$defs/criterion"},
        "goal_achievement": {"$ref": "#/$defs/criterion"},
        "conclusion_quality": {"$ref": "#/$defs/criterion"}
      }
    },
    "critical_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["false_success", "unsupported_claim", "wrong_interpretation"]
      }
    },
    "decisive_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reason"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 2},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
